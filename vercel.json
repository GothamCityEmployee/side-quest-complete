{
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/apple-pay-verification"
    }
  ],
  "redirects": [
    {
      "source": "/.well-known/:path*",
      "has": [{ "type": "host", "value": "sidequestcomplete.com" }],
      "destination": "https://sidequestcomplete.com/.well-known/:path*",
      "permanent": false
    }
  ]
}
